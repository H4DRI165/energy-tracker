rules_version = '2';

// Energy Tracker (v0.5.7) — Firestore security rules.
// Deny by default. User data is owner-scoped; tariff data is read-only.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Published domestic tariff schedule and monthly AFA rates.
    // Written only by the Admin SDK (seed script / scheduled function).
    match /tariffs/{scheduleId} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{uid} {

      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.fullName is string
        && request.resource.data.email is string
        && request.resource.data.tnbAccountNo is string
        && request.resource.data.monthlyBudget is number
        && request.resource.data.monthlyBudget >= 0
        && request.resource.data.onboardingCompleted is bool;

      allow update: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.monthlyBudget is number
        && request.resource.data.monthlyBudget >= 0;

      // Owner-scoped so the registration rollback can clean up a partial user.
      allow delete: if isOwner(uid);

      match /readings/{readingId} {
        allow read: if isOwner(uid);

        allow create, update: if isOwner(uid)
          && request.resource.data.reading is number
          && request.resource.data.kwh is number
          && request.resource.data.date is timestamp;

        allow delete: if isOwner(uid);
      }

      match /bills/{billId} {
        allow read: if isOwner(uid);

        // alertTierSent is reserved for the budget-alert Cloud Function.
        allow create: if isOwner(uid)
          && request.resource.data.kwh is number
          && request.resource.data.amount is number
          && !('alertTierSent' in request.resource.data);

        allow update: if isOwner(uid)
          && request.resource.data.kwh is number
          && request.resource.data.amount is number
          && (
            !('alertTierSent' in request.resource.data)
            || request.resource.data.alertTierSent ==
              resource.data.alertTierSent
          );

        allow delete: if isOwner(uid);
      }

      match /appliances/{applianceId} {
        allow read: if isOwner(uid);

        allow create, update: if isOwner(uid)
          && request.resource.data.name is string
          && request.resource.data.category is string
          && request.resource.data.wattage is number
          && request.resource.data.wattage >= 0
          && request.resource.data.dailyHours is number
          && request.resource.data.dailyHours >= 0
          && request.resource.data.dailyHours <= 24;

        allow delete: if isOwner(uid);
      }
    }

    // Default deny — no other collection is accessible.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
