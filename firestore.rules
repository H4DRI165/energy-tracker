rules_version = '2';

// Energy Tracker — Firestore security rules.
// Deny by default. All user data is owner-scoped (request.auth.uid == uid).
// Server-managed fields (e.g. bills.alertTierSent, gamification/*) are not
// writable from clients — only Cloud Functions (Admin SDK) may write them.
// See docs/SECURITY.md and docs/DATA_MODEL.md.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function validTariff(v) {
      return v in ['domestic', 'commercial'];
    }

    match /users/{uid} {

      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.fullName is string
        && request.resource.data.email is string
        && request.resource.data.tnbAccountNo is string
        && request.resource.data.tariffType is string
        && validTariff(request.resource.data.tariffType)
        && request.resource.data.monthlyBudget is number
        && request.resource.data.monthlyBudget >= 0
        && request.resource.data.onboardingCompleted is bool;

      allow update: if isOwner(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.tariffType is string
        && validTariff(request.resource.data.tariffType)
        && request.resource.data.monthlyBudget is number
        && request.resource.data.monthlyBudget >= 0;

      // Account deletion is handled server-side (see DATA_MODEL.md §9).
      allow delete: if false;

      match /readings/{readingId} {
        allow read: if isOwner(uid);

        allow create, update: if isOwner(uid)
          && request.resource.data.reading is number
          && request.resource.data.kwh is number
          && request.resource.data.date is timestamp
          && request.resource.data.tariffType is string
          && validTariff(request.resource.data.tariffType);

        allow delete: if isOwner(uid);
      }

      match /bills/{billId} {
        allow read: if isOwner(uid);

        // alertTierSent is reserved for the budget-alert Cloud Function.
        allow create: if isOwner(uid)
          && request.resource.data.kwh is number
          && request.resource.data.amount is number
          && !('alertTierSent' in request.resource.data);

        allow update: if isOwner(uid)
          && request.resource.data.kwh is number
          && request.resource.data.amount is number
          && (
            !('alertTierSent' in request.resource.data)
            || request.resource.data.alertTierSent == resource.data.alertTierSent
          );

        allow delete: if isOwner(uid);
      }

      match /appliances/{applianceId} {
        allow read: if isOwner(uid);

        allow create, update: if isOwner(uid)
          && request.resource.data.name is string
          && request.resource.data.category is string
          && request.resource.data.wattage is number
          && request.resource.data.wattage >= 0
          && request.resource.data.dailyHours is number
          && request.resource.data.dailyHours >= 0
          && request.resource.data.dailyHours <= 24;

        allow delete: if isOwner(uid);
      }

      // Gamification state is server-authoritative (awarded by Cloud
      // Functions). Clients may read their own state but never write it.
      match /gamification/{docId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // Default deny — no other collection is accessible.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
